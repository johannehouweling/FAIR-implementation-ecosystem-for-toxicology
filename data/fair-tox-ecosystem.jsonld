   ],
   "fairsharingRecord": "FAIRsharing.2gpf81",
   "fairsharingMatch": "confirmed",
   "reviewedBy": "IM",
   "note": "Research 5 Oct 2026 (medium confidence): Changed 2015 to 2014: the GitHub repository's v0.1 tag points at a commit of 2014-07-21 (a lightweight tag, so it carries no date of its own), and FAIRsharing gives 2014. The first GitHub release, v1.0, is dated 2015-03-11; Hastings et al. was received 2014-11-03 and published online 2015-03-21 (doi 10.1186/s13326-015-0005-5). URL changed from the paper DOI to the GitHub repository (FAIRsharing homepage). Active: last push 2026-09-17; latest release v10.0 (2023-07-12). Proposed 9 Oct 2026: OWL ontology of identified nanosafety terms and relations, applied when nanomaterial data are annotated at deposition and when they are integrated.",
   "fsrCategory": "https://w3id.org/fair/fip/terms/FAIR-Enabling-Resource",
   "qualifiedAttribution": [
    {
     "@type": "prov:Attribution",
     "hadRole": "In silico research"
    }
   ],
