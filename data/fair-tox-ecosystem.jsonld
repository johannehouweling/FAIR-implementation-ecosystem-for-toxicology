   "dateReleased": "2020-07-01",
   "dateSource": "https://web.archive.org/web/20200701123743/https://www.industrialchemicals.gov.au/",
   "creator": "AICIS (Australian Government)",
   "url": "https://services.industrialchemicals.gov.au",
   "description": "Online database search portal of Australia's industrial chemicals regulator, which replaced NICNAS in July 2020. It gives access to the Australian Inventory of Industrial Chemicals, published human-health and environmental hazard, exposure and risk assessments (including reports inherited from NICNAS) and risk-management recommendations.",
   "maintained": "active",
   "manuscript": "absent",
   "mentionedIn": [
    "FAIRSharing"
   ],
   "fairsharingRecord": "FAIRsharing.79e002",
   "fairsharingMatch": "confirmed",
   "note": "Added from the FAIRsharing Toxicology collection on 2026-10-05. Research 5 Oct 2026 (high confidence): Added from the FAIRsharing Toxicology collection on 2026-10-05. Included as AICIS's database (the 'AICIS Database Search Portal', called 'AICIS assessments' in eChemPortal) rather than the regulator itself, because FAIRsharing registers it as a knowledgebase; consider renaming the row. AICIS started on 1 July 2020, and the Wayback capture of that day shows its site already offering inventory and assessment search. The services portal itself is first captured 2022-10-05. FAIRsharing year 2020 agrees. Proposed 9 Oct 2026: A database that indexes and serves records under stable identifiers, typed Domain-specific registry as databases are in FIPs.",
   "fsrCategory": "https://w3id.org/fair/fip/terms/FAIR-Enabling-Resource",
   "qualifiedAttribution": [
    {
     "@type": "prov:Attribution",
     "hadRole": "Regulator"
    }
   ]
  },
