 "@id": "https://w3id.org/fair-tox/dataset",
 "@type": "schema:Dataset",
 "name": "FAIR implementation ecosystem for toxicology",
 "description": "Standards, databases, policies and tools used in toxicology, each typed as a FAIR-Enabling Resource or another FAIR Supporting Resource, curated by the ELIXIR Toxicology Community together with the FAIRsharing Toxicology collection, with first publication dates, FAIRsharing types, lifecycle phases, sub-domains and relations.",
 "version": "0.10.6",
 "dateModified": "2026-10-30",
 "license": {
  "@id": "https://creativecommons.org/licenses/by-sa/4.0/",
  "@type": "schema:CreativeWork",
  "name": "CC BY-SA 4.0",
  "url": "https://creativecommons.org/licenses/by-sa/4.0/"
 },
 "creator": {
  "@type": "schema:Organization",
  "name": "ELIXIR Toxicology Community",
  "url": "https://elixir-europe.org/communities/toxicology",
  "parentOrganization": {
   "@id": "https://ror.org/044rwnt51",
   "@type": "schema:Organization",
   "name": "ELIXIR"
  }
 },
 "creditText": "Contains information from FAIRsharing (https://fairsharing.org), licensed CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/).",
 "isBasedOn": [
  "https://doi.org/10.25504/FAIRsharing.f60a10"
 ],
 "sources": {
  "manuscript": {
   "name": "ELIXIR Toxicology Community paper, draft (8)",
   "file": "ELIXIR _Toxicology_Community_minutes_2026-2028 (8).txt",
   "dateModified": "2026-10-02",
   "sha256": "ebe9969a19eb36e8971e5efac8cce1cacdf759cc6248473fc14303934ab878a4"
  },
  "previous": {
   "name": "FAIR_tox inventory and audit",
   "date": "2026-10-02",
   "use": "evidence only, to verify"
  },
  "inventory": {
   "name": "a co-author's repository list, the Google Sheet tox_repository_list_v3, tab repositories",
   "read": "2026-10-21",
   "rows": "42, of which 30 kept or added (tiers A and B); 19 already in the dataset",
   "resources": [
    "pride",
    "bioimage_archive",
    "immport",
    "figshare",
    "osf",
    "norman_ecotox",
    "norman_bioassays",
    "dsfp",
    "massbank_eu",
    "uba_etox"
   ]
  }
 },
 "vocabularies": {
  "decision": {
   "include": "Meets all inclusion criteria (I1-I5 in docs/inclusion-criteria.md).",
   "exclude": "Fails a criterion; the exclusion reason says which.",
   "undecided": "Not yet screened, or left for the co-authors to decide."
  },
  "exclusionReason": {
   "E1": "Organisation, project, initiative, consortium, community or event; its named product is listed instead.",
   "E2": "Principle, framework, method or approach, or a publication only, rather than a resource that can be used directly; a standard, database, policy or tool that puts it into practice is listed instead.",
   "E3": "Unnamed or not identifiable (no homepage or DOI).",
   "E4": "Never publicly available.",
   "E5": "No documented toxicology use.",
   "E6": "Duplicate, version or component of another row (see Covered by).",
   "E7": "Outside chemical toxicology, such as toxinology or clinical adverse-event grading.",
   "E8": "Test method or guideline that standardises an experiment rather than data or metadata."
  },
  "fairsharingType": {
   "Standard: model/format": "Data or metadata model, schema, exchange format.",
   "Standard: terminology artefact": "Ontology, controlled vocabulary, thesaurus or glossary.",
   "Standard: reporting guideline": "Minimum information checklist or reporting template.",
   "Standard: identifier schema": "Identifier scheme or resolver.",
   "Standard: principle": "Published set of principles with a reusable artefact.",
   "Database: repository": "Archive that accepts data deposits.",
   "Database: knowledgebase": "Curated knowledge resource or data portal.",
   "Database: knowledgebase and repository": "Both a curated knowledge resource and an archive.",
   "Policy: journal": "Data policy of a journal.",
   "Policy: journal publisher": "Data policy of a publisher.",
   "Policy: society": "Policy or guidance of a learned society.",
   "Policy: funder": "Data policy of a funder.",
   "Policy: project": "Policy or guidance issued by a project.",
   "Policy: institution": "Policy or guidance issued by an institution or agency, such as OECD guidance.",
   "Collection": "Curated collection of standards, databases and policies.",
   "Tool": "Software or service; FAIRsharing does not register these."
  },
  "scope": {
   "Generic": "Infrastructure not specific to a research domain, including FAIR resources such as the FIP.",
   "Life Sciences": "Life-science infrastructure, not specific to toxicology, that toxicology uses.",
   "Toxicology": "Made for toxicology, including toxicology instances of generic resources."
  },
  "phase": {
   "Data generation": "Supports the planning of individual toxicology studies, the recording of their results and study context (metadata, protocols, data processing) and the deposition of study-level datasets linked to that context.",
   "Data integration": "Supports the linking of existing research output from different studies across test systems, stressors, exposures and endpoints, with mechanistic knowledge and models; includes the derivative objects this produces.",
   "Regulatory assessment": "Supports the reporting of studies for regulatory submission and the identification and evaluation of toxicology research outputs for a specified regulatory question."
  },
  "creatorType": {
   "Wet-lab research": "Made by experimental (wet-lab) researchers, mostly academic.",
   "In silico research": "Made by computational researchers: modellers, AOP, PBK, QSAR, informatics and data stewards.",
   "Regulator": "Made by a regulatory agency or intergovernmental body, such as OECD, EFSA, ECHA or US EPA."
  },
  "lane": {
   "Generic infrastructure": "Resources not specific to a research domain.",
   "Life sciences infrastructure": "Life-science resources, not specific to toxicology, that toxicology uses.",
   "Data generation": "Toxicology resources whose earliest phase is data generation; it supports the planning of individual toxicology studies, the recording of their results and study context (metadata, protocols, data processing) and the deposition of study-level datasets linked to that context.",
   "Data integration": "Toxicology resources whose earliest phase is data integration; it supports the linking of existing research output from different studies across test systems, stressors, exposures and endpoints, with mechanistic knowledge and models; includes the derivative objects this produces.",
   "Regulatory assessment": "Toxicology resources whose earliest phase is regulatory assessment; it supports the reporting of studies for regulatory submission and the identification and evaluation of toxicology research outputs for a specified regulatory question."
  },
  "creatorLane": {
   "Made by wet-lab research": "Toxicology resources made by wet-lab research only.",
   "Made by in silico research": "Toxicology resources made by in silico research only.",
   "Made by regulators": "Toxicology resources made by regulators only.",
   "Made jointly": "Toxicology resources made by two or more creator types together."
  },
  "subdomains": {
   "in vitro toxicology": "Toxicology studied in vitro: in the laboratory, usually with isolated organ, tissue, cell or biochemical systems (after IUPAC, 1993, doi:10.1351/pac199365092003).",
   "nanotoxicology": "Data generation.",
   "exposome": "Data generation.",
   "eco-toxicology": "Data generation.",
   "toxicogenomics": "Integration and tools.",
   "AOP-based mechanistic knowledge": "Integration and tools.",
   "computational and predictive toxicology": "Integration and tools.",
   "regulatory toxicology": "Toxicology that collects, processes and evaluates experimental and epidemiological data as the basis for decisions that protect health from the harmful effects of chemical substances, and that develops standard protocols and new test methods for them (after Schwenk et al., 2002, doi:10.1016/S0378-4274(01)00457-X)."
  },
  "dateBasis": {
   "publication": "Online publication of the paper that first describes the resource.",
   "release": "First public release or launch.",
   "adoption": "Official adoption or publication of guidance or policy.",
   "FAIRsharing year": "FAIRsharing's year of creation, used only when nothing better was found."
  },
  "maintained": {
   "active": "Maintained and available.",
   "discontinued": "No longer maintained or available (shown with a dagger).",
   "in development": "Not yet released in a stable form.",
   "unknown": "Status could not be established."
  },
  "manuscript": {
   "cited": "Named in the manuscript text with a reference.",
   "named": "Named in the manuscript text without a reference.",
   "comment only": "Named only in a comment or to-do note of the manuscript.",
   "absent": "Not in the manuscript."
  },
  "fairsharingMatch": {
   "confirmed": "The FAIRsharing record is this resource.",
   "to check": "A FAIRsharing record was proposed and needs a curator.",
   "no record": "FAIRsharing has no record for this resource."
  },
  "hadRole": {
   "implements": "The subject implements the standard or FAIR specification.",
   "extends": "The subject builds on and extends the target.",
   "profiles": "The standard is a profile of the target standard.",
   "recommends": "The policy or guidance recommends the target.",
   "deprecates": "The subject replaces the target.",
   "related_to": "The resources are related without one building on the other.",
   "uses": "The subject uses the target."
  },
  "declaration": {
   "declares-current-use-of": "The FIP declares that its community uses the target.",
   "declares-planned-use-of": "The FIP declares that its community plans to use the target.",
   "declares-planned-development-of": "The FIP declares that its community plans to develop the target.",
   "declares-planned-replacement-of": "The FIP declares that its community plans to replace the target.",
   "declared-by": "The FIP is declared by the target, a FAIR Implementation Community."
  },
  "evidence": {
   "manuscript": "Stated in the manuscript.",
   "FAIRsharing": "Asserted by FAIRsharing.",
   "literature": "Stated in the literature or on the resource website.",
   "curator": "Added by a curator.",
   "FIP": "Declared in a FAIR Implementation Profile."
  },
  "mentionedIn": {
   "Whitepaper": "Martens et al. 2023, \"ELIXIR and Toxicology: a community in development\", F1000Research, doi 10.12688/f1000research.74502.2.",
   "FAIRSharing": "FAIRsharing's report on the ELIXIR Toxicology Community collection, 3 Jul 2025, doi 10.5281/zenodo.15799783.",
   "INTOXICOM 1": "Report of INTOXICOM workshop 1: Martens et al. 2024, BioHackrXiv, doi 10.37044/osf.io/un2rw.",
   "INTOXICOM 2": "Report of INTOXICOM workshop 2: Bonatto Minella et al. 2026, BioHackrXiv, doi 10.37044/osf.io/64dfv_v1.",
   "INTOXICOM 3": "Report of INTOXICOM workshop 3: Bünger et al. 2026, BioHackrXiv, doi 10.37044/osf.io/u3fnh_v1.",
   "INTOXICOM 4": "Report of INTOXICOM workshop 4: Martens et al., draft, github.com/TGX-UM/INTOXICOM_Workshop_4.",
   "INTOXICOM 5": "Report of INTOXICOM workshop 5: Evelo et al. 2026, BioHackrXiv, doi 10.37044/osf.io/zf2qj_v1."
  }
 },
