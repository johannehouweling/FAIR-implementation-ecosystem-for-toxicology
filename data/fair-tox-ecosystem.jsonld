   "dateAdopted": "2008-01-15",
   "dateSource": "https://www.w3.org/TR/2008/REC-rdf-sparql-query-20080115/",
   "creator": "W3C",
   "url": "https://www.w3.org/TR/sparql11-query/",
   "description": "The W3C query language and protocol for RDF data. Through SPARQL endpoints, people and software can query and combine linked datasets, such as AOP-Wiki RDF and AOP-DB RDF, in a standard way.",
   "maintained": "active",
   "manuscript": "named",
   "manuscriptEvidence": "III AOP; L126, L129",
