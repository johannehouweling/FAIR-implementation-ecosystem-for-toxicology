     "note": "Checked 5 Oct 2026: The eNanoMapper ontology build imports a slimmed OBI module (obi.owl, about 1,900 OBI classes in the published slim)."
    },
    {
     "relation": "https://doi.org/10.25504/FAIRsharing.62qk8w",
     "hadRole": "extends",
     "evidence": "literature",
     "source": "https://github.com/enanomapper/ontologies/blob/master/config/chebi.props",
     "note": "Checked 5 Oct 2026: The eNanoMapper ontology build imports a slimmed ChEBI module (from chebi_lite.obo, several hundred ChEBI classes in the published slim)."
    },
    {
     "relation": "https://doi.org/10.25504/FAIRsharing.atygwy",
     "hadRole": "implements",
     "evidence": "curator"
    },
    {
     "relation": "https://doi.org/10.25504/FAIRsharing.j9y503",
     "hadRole": "extends",
     "evidence": "literature",
     "source": "https://github.com/enanomapper/ontologies/blob/master/config/clo.props",
     "note": "Checked 5 Oct 2026: The import configuration named 'clo' actually slims the Cell Ontology (cl.owl), so CL cell-type classes such as lung macrophage are imported into the eNanoMapper ontology."
    },
    {
     "relation": "https://doi.org/10.25504/FAIRsharing.mye76w",
     "hadRole": "extends",
     "evidence": "literature",
     "source": "https://github.com/enanomapper/ontologies/blob/master/config/bao.props",
     "note": "Checked 5 Oct 2026: The eNanoMapper ontology build imports a slimmed BAO module (about 700 BAO classes), and the eNanoMapper database paper names BAO as reused content."
    }
   ]
