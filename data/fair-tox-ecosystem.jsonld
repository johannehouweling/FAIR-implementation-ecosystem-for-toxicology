   "datePublished": "2008",
   "dateSource": "https://doi.org/10.1007/978-3-540-88562-7_15",
   "creator": "SED-ML community (COMBINE); initiated at EMBL-EBI",
   "url": "https://sed-ml.org",
   "description": "SED-ML is an XML format for describing simulation experiments on computational models: which models to use, how to change them, which simulations to run and which outputs to produce. It makes model-based simulation results reproducible across software tools.",
   "maintained": "active",
   "manuscript": "cited",
   "manuscriptEvidence": "III Computational; L146",
   "fairsharingRecord": "FAIRsharing.6f7m6j",
   "fairsharingMatch": "confirmed",
   "note": "Research 5 Oct 2026 (high confidence): I corrected the date from 2011. SED-ML was first described in Köhn & Le Novère, 'SED-ML - An XML Format for the Implementation of the MIASE Guidelines', CMSB 2008, LNCS 5307 (Crossref issued 2008; DOI registered 2008-10-04). The previous source, Waltemath et al., BMC Syst Biol, online 2011-12-15, is a later description. FAIRsharing year 2008 agrees. The current specification is Level 1 Version 5 (COMBINE). Proposed 9 Oct 2026: XML format that describes simulation experiment setups on computational models in a structured, machine-readable way, so a metadata schema.",
   "fsrCategory": "https://w3id.org/fair/fip/terms/FAIR-Enabling-Resource",
   "qualifiedRelation": [
    {
     "relation": "https://doi.org/10.25504/FAIRsharing.9qv71f",
     "hadRole": "related_to",
     "evidence": "manuscript",
     "source": "manuscript draft, line 146",
     "note": "Checked 5 Oct 2026: The draft names SED-ML as the standard for simulation experiments that complements SBML; SED-ML points to models in SBML and other formats without extending SBML."
    }
   ]
  },
