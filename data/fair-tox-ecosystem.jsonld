   "@id": "https://doi.org/10.25504/FAIRsharing.a6dcff",
   "identifier": "https://doi.org/10.25504/FAIRsharing.a6dcff",
   "schemaType": "schema:CreativeWork",
   "key": "nanopub",
   "name": "Nanopublication",
   "alternateName": [
    "machine-readable nanopublication"
   ],
   "decision": "include",
   "fairsharingType": "Standard: model/format",
   "fsrType": [
    "https://w3id.org/fair/fip/terms/Provenance-model"
   ],
   "scope": "Generic",
   "subdomains": [
    "AOP-based mechanistic knowledge"
   ],
   "datePublished": "2009-10-20",
   "dateSource": "https://ceur-ws.org/Vol-523/",
   "creator": "Concept Web Alliance / NBIC",
   "url": "https://nanopub.net",
   "description": "A nanopublication is the smallest publishable unit of information: a single assertion in RDF, packaged with named graphs that hold its provenance and publication metadata. Nanopublications get resolvable, verifiable identifiers and are spread over a decentralised server network, so machines can find, cite and reuse individual statements such as AOP or FIP declarations.",
   "maintained": "active",
   "manuscript": "named",
   "manuscriptEvidence": "III AOP; L135",
   "fairsharingRecord": "FAIRsharing.a6dcff",
   "fairsharingMatch": "confirmed",
   "note": "Research 5 Oct 2026 (medium confidence): Mons & Velterop introduced the concept in 'Nano-Publication in the e-Science Era' (SWASD 2009 workshop, CEUR-WS Vol-523, published 2009-10-20, https://ceur-ws.org/Vol-523/Mons.pdf). The model with assertion, provenance and publication info was formalised in Groth, Gibson & Velterop, Inf Serv Use 2010 (online 2010-02-01, doi 10.3233/ISU-2010-0613). Use 2010-02 if the format paper is preferred. FAIRsharing 'Nanopublication Schema' (FAIRsharing.a6dcff): model/format, year 2015, homepage nanopub.net. Creator changed from author names to the authors' organisations (Concept Web Alliance, Netherlands Bioinformatics Centre). Verified 5 Oct 2026: fairsharingMatch changed (One lookup of https://fairsharing.org/FAIRsharing.a6dcff returns id 4396 'Nanopublication Schema' (Nanopub): model_and_format, homepage https://nanopub.net/. This matches the row's URL and type.) Proposed 9 Oct 2026: A model packaging each RDF assertion with its provenance and publication metadata under one verifiable identifier, linking data and metadata.",
   "fsrCategory": "https://w3id.org/fair/fip/terms/FAIR-Enabling-Resource",
   "qualifiedRelation": [
    {
     "relation": "https://doi.org/10.25504/FAIRsharing.p77ph9",
     "hadRole": "uses",
     "evidence": "curator",
     "reviewedBy": "Egon"
    }
   ]
  },
