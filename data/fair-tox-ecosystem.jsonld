  {
   "@id": "https://doi.org/10.25504/FAIRsharing.96f3gm",
   "identifier": "https://doi.org/10.25504/FAIRsharing.96f3gm",
   "schemaType": "schema:CreativeWork",
   "key": "chemspider",
   "name": "ChemSpider",
   "alternateName": [
    "ChemSpider"
   ],
   "decision": "include",
   "fairsharingType": "Database: knowledgebase",
   "fsrType": [
